
{
  "expo": {
    "name": "CampusBuzz",
    "slug": "CampusBuzz",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/converted_image.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/converted_image.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/converted_image.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.attendify.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-barcode-scanner"
    ],
    "owner": "kolinsy"
  }
}